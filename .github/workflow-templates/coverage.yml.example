# INACTIVE EXAMPLE. This extension is not executed by GitHub Actions.
# Approved scope: package and own scripts, line/branch measurement, no threshold.
# Configure Codecov for the actual repository before enabling an upload.
name: coverage
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  report:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7
        with:
          python-version: "3.11"
      - uses: astral-sh/setup-uv@07a047e608db84b3d8c06cd9a7c7dcc9c355c18e # v10.3.2
        with:
          version: "0.13.5"
      - run: uv sync --locked --group dev
      - run: uv run --locked pytest --cov --cov-report=term-missing
      - run: uv run --locked coverage run --append scripts/check_notebooks.py
      - run: uv build
      - run: uv run --locked twine check dist/*
      - run: uv run --locked coverage run --append scripts/check_distribution.py
      - run: uv run --locked coverage xml
      # Keep the upload disabled until Codecov is configured and upload is authorized.
      - name: Upload an explicitly configured coverage report
        if: ${{ false }}
        uses: codecov/codecov-action@303a32d7a59b442fa8d48b6a1cc6825c09c847a5 # v7
        with:
          files: coverage.xml
          disable_search: true
          token: ${{ secrets.CODECOV_TOKEN }}
          fail_ci_if_error: false
